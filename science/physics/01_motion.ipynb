   "source": [
    "# Равномерное движение\n",
    "\n",
    "Скорость показывает, какое расстояние тело проходит\n",
    "за единицу времени.\n",
    "\n",
    "Формула:\n",
    "\n",
    "v = s / t\n",
    "\n",
    "где:\n",
    "- v — скорость\n",
    "- s — расстояние\n",
    "- t — время"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1d2becf0-236d-45ea-a513-7beeaee25dda",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "10.0\n"
     ]
    }
   ],
   "source": [
    "s = 100\n",
    "t = 10\n",
    "\n",
    "v = s / t\n",
    "\n",
    "print(v)"
   ]
  }
 ],
